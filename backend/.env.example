# ==============================================================================
# CipherGuard AI - Backend Environment Configuration Example
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database (Member 2)
DATABASE_URL="postgresql://cipherguard:cipherguard_secret@localhost:5432/cipherguard_db?schema=public"

# JWT Authentication (Member 2)
JWT_ACCESS_SECRET="change-this-to-a-very-long-and-secure-random-secret-for-jwt-access-tokens"
JWT_REFRESH_SECRET="change-this-to-another-very-long-and-secure-random-secret-for-jwt-refresh"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# FastApi ML Microservice (Member 1)
ML_SERVICE_URL="http://localhost:8000"

# ==============================================================================
# Cryptography & Secure Storage Configuration (Member 3)
# ==============================================================================

# Dedicated Storage Locations
CIPHERGUARD_STORAGE_ROOT="./storage"
CIPHERGUARD_ENCRYPTED_STORAGE_DIR="./storage/encrypted"
CIPHERGUARD_TEMP_STORAGE_DIR="./storage/temp"

# RSA-OAEP Key Management for Envelope Encryption
# In development: either specify paths to PEM files or allow ephemeral keys.
# In production: provide CIPHERGUARD_RSA_PUBLIC_KEY and CIPHERGUARD_RSA_PRIVATE_KEY
# via AWS Secrets Manager or HashiCorp Vault.
CIPHERGUARD_RSA_PUBLIC_KEY_PATH="./secrets/rsa_public.pem"
CIPHERGUARD_RSA_PRIVATE_KEY_PATH="./secrets/rsa_private.pem"

# In dev/test only, set to 'true' to allow generating ephemeral keys in-memory if no key is configured
CIPHERGUARD_ALLOW_DEV_KEYS="true"
